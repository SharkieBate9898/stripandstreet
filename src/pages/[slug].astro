---
import Base from '../layouts/Base.astro';
import PostArt from '../components/PostArt.astro';
import PostCard from '../components/PostCard.astro';
import Newsletter from '../components/Newsletter.astro';
import AdSlot from '../components/AdSlot.astro';
import { render } from 'astro:content';
import { SITE, categoryBySlug } from '../consts';
import { getPosts, related, formatDate, readingTime, type Post } from '../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, all: posts } }));
}

const { post, all } = Astro.props as { post: Post; all: Post[] };
const d = post.data;
const cat = categoryBySlug(d.category);
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
const more = related(post, all);
const url = new URL(`/${post.id}/`, Astro.site).href;
const body = post.body ?? '';
const hasAffiliate = body.includes('(#affiliate') || /amzn\.to|amazon\.com\/|tag=/.test(body);
const image = d.heroImage ?? SITE.ogImage;

const schema: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.title,
    description: d.description,
    image: [new URL(image, Astro.site).href],
    datePublished: d.pubDate.toISOString(),
    dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
    author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    publisher: { '@type': 'Organization', name: SITE.name, logo: { '@type': 'ImageObject', url: `${SITE.url}/logo-square.png` } },
    mainEntityOfPage: url,
    articleSection: cat.name,
    keywords: [d.keyword, ...d.tags].filter(Boolean).join(', '),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: cat.name, item: `${SITE.url}/category/${cat.slug}/` },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];
if (d.faq.length) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
const share = {
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`,
  x: `https://x.com/intent/post?url=${encodeURIComponent(url)}&text=${encodeURIComponent(d.title)}`,
  reddit: `https://www.reddit.com/submit?url=${encodeURIComponent(url)}&title=${encodeURIComponent(d.title)}`,
};
---

<Base
  title={d.title}
  description={d.description}
  image={d.heroImage}
  type="article"
  schema={schema}
  publishedTime={d.pubDate}
  modifiedTime={d.updatedDate}
>
  <article style={`--cat:${cat.color}`}>
    <header class="wrap head">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span>/</span><a href={`/category/${cat.slug}/`}>{cat.name}</a>
      </nav>
      <h1 class="display">{d.title}</h1>
      <p class="dek">{d.description}</p>
      <p class="meta">
        <a class="cat-chip" href={`/category/${cat.slug}/`}>{cat.name}</a>
        <span>By Strip and Street</span>
        <time datetime={d.pubDate.toISOString()}>{formatDate(d.pubDate)}</time>
        {d.updatedDate && <span>Updated <time datetime={d.updatedDate.toISOString()}>{formatDate(d.updatedDate)}</time></span>}
        <span>{readingTime(body)} min read</span>
      </p>
    </header>

    <div class="wrap hero">
      <PostArt title={d.title} category={d.category} image={d.heroImage} alt={d.heroAlt} size="hero" eager />
      {d.heroCredit && (
        <p class="credit">Photo: {d.heroCreditUrl ? <a href={d.heroCreditUrl} rel="noopener" target="_blank">{d.heroCredit}</a> : d.heroCredit} on Unsplash</p>
      )}
    </div>

    <div class="wrap layout">
      <div class="main">
        {hasAffiliate && (
          <p class="disclosure">
            Heads up: some links in this post are affiliate links. If you buy through them, Strip and Street may earn a small commission at no extra cost to you. <a href="/affiliate-disclosure/">Details</a>.
          </p>
        )}

        {toc.length > 2 && (
          <details class="toc" open>
            <summary class="eyebrow">In this guide</summary>
            <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </details>
        )}

        <div class="prose"><Content /></div>

        <AdSlot slot="inArticle" />

        {d.faq.length > 0 && (
          <section class="faq" aria-labelledby="faq-title">
            <h2 id="faq-title" class="display">FAQ</h2>
            {d.faq.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </section>
        )}

        <div class="share">
          <span class="eyebrow">Share this</span>
          <a href={share.facebook} target="_blank" rel="noopener">Facebook</a>
          <a href={share.x} target="_blank" rel="noopener">X</a>
          <a href={share.reddit} target="_blank" rel="noopener">Reddit</a>
        </div>

        {d.tags.length > 0 && <p class="tags">{d.tags.map((t) => <span>#{t}</span>)}</p>}

        <div class="nl"><Newsletter /></div>
      </div>

      <aside class="rail">
        <div class="sticky">
          <p class="eyebrow">Keep reading</p>
          {more.map((p) => <PostCard post={p} />)}
          <AdSlot slot="sidebar" />
        </div>
      </aside>
    </div>
  </article>
</Base>

<style>
  .head { padding-top: clamp(28px, 5vw, 56px); max-width: 980px; margin-left: auto; margin-right: auto; }
  .crumbs { display: flex; gap: 10px; font-family: var(--font-mono); font-size: 12px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--chalk-mute); }
  .crumbs a { text-decoration: none; color: var(--chalk-dim); }
  h1 { font-size: clamp(40px, 6.4vw, 84px); margin-top: 18px; }
  .dek { font-size: clamp(18px, 2vw, 22px); color: var(--chalk-dim); max-width: 60ch; margin: 18px 0; }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 18px; font-family: var(--font-mono); font-size: 12.5px; color: var(--chalk-mute); margin: 0; }
  .hero { margin-top: 32px; max-width: 1200px; }
  .credit { font-size: 12.5px; color: var(--chalk-mute); margin: 8px 0 0; }
  .layout { display: grid; grid-template-columns: minmax(0, 720px) 300px; justify-content: space-between; gap: 56px; margin-top: 48px; }
  .disclosure {
    font-size: 14.5px; color: var(--chalk-dim); background: var(--asphalt-2); border-left: 3px solid var(--amber);
    padding: 12px 16px; margin: 0 0 28px;
  }
  .toc { background: var(--asphalt-2); border: 1px solid var(--line); border-radius: var(--radius); padding: 18px 22px; margin-bottom: 36px; }
  .toc summary { cursor: pointer; color: var(--chalk); }
  .toc ol { margin: 12px 0 0; padding-left: 0; list-style: none; display: grid; gap: 6px; }
  .toc li::marker { color: var(--signal); font-family: var(--font-mono); font-size: 13px; }
  .toc a { text-decoration: none; color: var(--chalk-dim); }
  .toc a:hover { color: var(--signal); }
  .faq { margin-top: 56px; }
  .faq h2 { font-size: 40px; margin-bottom: 18px; }
  .faq details { border-top: 1px solid var(--line); padding: 16px 0; }
  .faq details:last-child { border-bottom: 1px solid var(--line); }
  .faq summary { cursor: pointer; font-weight: 700; font-size: 18px; list-style: none; display: flex; justify-content: space-between; gap: 16px; }
  .faq summary::after { content: '+'; color: var(--signal); font-family: var(--font-mono); }
  .faq details[open] summary::after { content: '–'; }
  .faq p { margin: 12px 0 0; color: var(--chalk-dim); font-family: var(--font-prose); font-size: 17.5px; }
  .share { display: flex; flex-wrap: wrap; align-items: center; gap: 18px; margin-top: 44px; padding-top: 22px; border-top: 1px solid var(--line); }
  .share .eyebrow { margin-right: 4px; }
  .share a { font-family: var(--font-mono); font-size: 13px; text-transform: uppercase; letter-spacing: 0.06em; text-decoration: none; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; margin: 18px 0 0; }
  .tags span { font-family: var(--font-mono); font-size: 12px; color: var(--chalk-mute); background: var(--asphalt-2); padding: 4px 9px; border-radius: 3px; }
  .nl { margin-top: 48px; }
  .rail .sticky { position: sticky; top: 100px; display: grid; gap: 22px; }
  .rail .eyebrow { margin: 0; color: var(--signal); }
  .rail :global(.desc) { display: none; }
  .rail :global(h3) { font-size: 19px; }
  .prose :global(a[href='#affiliate']) {
    text-decoration: none; color: var(--amber); border-bottom: 1px dashed var(--amber);
  }
  @media (max-width: 1060px) {
    .layout { grid-template-columns: minmax(0, 1fr); }
    .rail .sticky { position: static; }
  }
</style>
