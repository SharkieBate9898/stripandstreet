---
import { ADS } from '../consts';
interface Props { slot: 'inArticle' | 'sidebar' }
const { slot } = Astro.props;
const id = ADS.slots[slot];
---
{ADS.enabled && ADS.client && id && (
  <aside class="ad" aria-label="Advertisement">
    <span class="eyebrow">Advertisement</span>
    <ins class="adsbygoogle" style="display:block" data-ad-client={ADS.client} data-ad-slot={id} data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
  </aside>
)}
<style>
  .ad { margin: 36px 0; text-align: center; }
  .ad .eyebrow { display: block; margin-bottom: 6px; font-size: 10px; }
</style>
