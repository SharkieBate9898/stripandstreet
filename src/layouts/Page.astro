---
import Base from './Base.astro';
interface Props { title: string; description?: string; eyebrow?: string; noindex?: boolean }
const { title, description, eyebrow, noindex } = Astro.props;
---
<Base title={title} description={description} noindex={noindex}>
  <div class="wrap page">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="display">{title}</h1>
    <div class="prose"><slot /></div>
  </div>
</Base>
<style>
  .page { max-width: 780px; padding-top: clamp(32px, 6vw, 72px); }
  h1 { font-size: clamp(44px, 7vw, 88px); margin: 12px 0 36px; }
</style>
